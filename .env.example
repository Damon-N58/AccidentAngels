# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
NEXTAUTH_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Cron (protects /api/cron/billing and /api/cron/check-expiry)
CRON_SECRET=

# WhatsApp Cloud API (OTP delivery). Set OTP_MODE=dev to force OTPs to log to console instead of
# sending (also auto-enabled if credentials for the selected channel are unset). Set OTP_MODE=live
# to send for real. Set OTP_MODE=hybrid to send for real AND log the code to console (handy for
# testing without needing the phone at hand). Two channels: driver (also used for admin logins)
# and parent.
OTP_MODE=live
WHATSAPP_PHONE_NUMBER_ID_DRIVER=
WHATSAPP_ACCESS_TOKEN_DRIVER=
WHATSAPP_PHONE_NUMBER_ID_PARENT=
WHATSAPP_ACCESS_TOKEN_PARENT=
WHATSAPP_TEMPLATE_NAME=otp_auth
WHATSAPP_TEMPLATE_LANG=en_US

# Africa's Talking SMS (non-OTP notifications: compliance, trip, and billing alerts)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=AccidentAngels

# App URLs (defaults point to production; override for local/staging)
NEXT_PUBLIC_DRIVER_URL=https://driver.accidentangels.co.za
NEXT_PUBLIC_PARENT_URL=https://parent.accidentangels.co.za
NEXT_PUBLIC_ADMIN_URL=https://admin.accidentangels.co.za

# Which sub-app localhost/unknown hosts proxy to: driver | parent | admin
NEXT_PUBLIC_LOCAL_APP=driver
