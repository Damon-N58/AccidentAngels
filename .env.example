# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
NEXTAUTH_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Cron (protects /api/cron/billing and /api/cron/check-expiry)
CRON_SECRET=

# Africa's Talking SMS (OTP). If AT_API_KEY is unset, OTPs are logged to console instead of sent.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=AccidentAngels

# Set to 'true' to send OTPs via real SMS (login codes are never returned in the API response).
# Leave 'false' for local/demo use — codes are skipped and returned directly in the response.
USE_SMS_AUTH=false

# App URLs (defaults point to production; override for local/staging)
NEXT_PUBLIC_DRIVER_URL=https://driver.accidentangels.co.za
NEXT_PUBLIC_PARENT_URL=https://parent.accidentangels.co.za
NEXT_PUBLIC_ADMIN_URL=https://admin.accidentangels.co.za

# Which sub-app localhost/unknown hosts proxy to: driver | parent | admin
NEXT_PUBLIC_LOCAL_APP=driver